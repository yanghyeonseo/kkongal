# =============================================================================
# kkongal 백엔드(gunicorn) systemd 유닛.
#
# 설치:
#   sudo cp deploy/kkongal.service /etc/systemd/system/kkongal.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kkongal
#   sudo systemctl status kkongal      # 상태 확인
#   journalctl -u kkongal -f           # 로그 확인
#
# 경로/사용자(User, WorkingDirectory, ExecStart)는 실제 배포 환경에 맞게 수정한다.
# 환경 변수는 EnvironmentFile 의 backend/.env 에서 읽는다(DEBUG=False, DATABASE_URL 등).
# =============================================================================
[Unit]
Description=kkongal gunicorn (Django API)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kkongal/backend
EnvironmentFile=/home/ubuntu/kkongal/backend/.env
ExecStart=/home/ubuntu/kkongal/backend/.venv/bin/gunicorn -c gunicorn.conf.py kkongal.wsgi:application
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
