# =============================================================================
# 꽁알꽁알(kkongal) 백엔드 환경 변수 예시
# -----------------------------------------------------------------------------
# 이 파일을 복사해서 backend/.env 로 만들고 값을 채우세요.
#     cp backend/.env.example backend/.env
# .env 는 절대 커밋하지 마세요(.gitignore 에 의해 제외됨).
# =============================================================================

# ── Django 코어 ──────────────────────────────────────────────────────────────
# SECRET_KEY 는 아래 명령으로 새로 생성하는 것을 권장합니다.
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
# 로컬 개발은 True. ⚠️ 프로덕션에서는 반드시 False (스택트레이스·설정 노출 방지).
DEBUG=True

# ── 배포(프로덕션) 설정 — DEBUG=False 일 때 필수 ─────────────────────────────
# 로컬 개발에서는 아래 값들을 비워둬도 됩니다(안전한 기본값으로 동작). 배포 시 채우세요.
#
# 서비스 도메인(콤마 구분). DEBUG=False 이면 여기에 없는 Host 요청은 400 으로 막힙니다.
# ALLOWED_HOSTS=kkongal.cloud,www.kkongal.cloud
# HTTPS POST/admin 로그인 신뢰 오리진(스킴 포함, 콤마 구분).
# CSRF_TRUSTED_ORIGINS=https://kkongal.cloud
# SPA 를 API 와 다른 오리진에서 서빙할 때만 필요(동일 오리진 nginx 배포면 불필요).
# CORS_ALLOWED_ORIGINS=https://kkongal.cloud
#
# 데이터베이스. 미설정 시 로컬 SQLite. 프로덕션은 PostgreSQL 을 씁니다
# (가비아 서버에 직접 설치 — docs/DEPLOY.md 참고).
# DATABASE_URL=postgres://kkongal:PASSWORD@127.0.0.1:5432/kkongal
#
# 보안 하드닝(대개 기본값으로 충분, 필요 시만 조정):
#   AUTH_COOKIE_SECURE  : 인증 쿠키 Secure 플래그(기본: DEBUG=False 이면 True)
#   SECURE_SSL_REDIRECT : HTTP→HTTPS 리다이렉트(기본 True). 앞단(nginx)이 리다이렉트하면 False 로.
#   CRAWLER_VERIFY_TLS  : 크롤러 TLS 검증(기본 True, 그대로 두는 것을 권장)
#   LOG_LEVEL           : 로그 레벨(기본 INFO)
#   THROTTLE_AUTH       : 로그인/회원가입 rate limit(기본 10/min)
# AUTH_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# =============================================================================
# AI 공지 선별 (LLM) — OpenAI 호환 Chat Completions API + 3단 캐스케이드
# -----------------------------------------------------------------------------
# 운영 기본값은 OpenAI (platform.openai.com/api-keys 에서 키 발급).
#   1) https://platform.openai.com/api-keys 에서 secret key 생성
#   2) 아래 LLM_API_KEY 에 붙여넣기
# 무료로 쓰고 싶으면 Google Gemini(무료 티어)도 가능 — 아래 제공자별 예시 참고.
# 키가 비어 있으면 키워드 기반 폴백으로 동작하므로, 키 없이도 데모/테스트가 됩니다.
#
# 3단 캐스케이드로 무료 티어 한도를 방어합니다:
#   1차 = LLM_MODEL  →  2차 = LLM_FALLBACK_MODEL  →  3차 = 결정론적 키워드 폴백
# 1·2차 LLM 은 같은 LLM_BASE_URL·LLM_API_KEY 를 공유하고 '모델 문자열'만 다릅니다.
# 두 LLM 계층이 모두 실패할 때만 대시보드에 "키워드 기반 임시 동작 중" 배너가 뜹니다.
#
# 다른 저렴한 제공자로 교체하려면 BASE_URL / MODEL / API_KEY 세 값만 바꾸면 됩니다:
#   • OpenAI     : LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-5.6-luna
#   • Gemini(무료): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  LLM_MODEL=gemini-2.5-flash-lite  (키: https://aistudio.google.com/apikey)
#   • DeepSeek   : LLM_BASE_URL=https://api.deepseek.com/v1           LLM_MODEL=deepseek-chat
#   • Groq(무료) : LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
#
# ⚠️ OpenAI 의 gpt-5 / gpt-5.6 계열과 o-시리즈는 temperature 를 거부하거나 기본값 1
#    만 받습니다. 이 모델들을 쓰려면 아래 LLM_TEMPERATURE 를 '비워서' 파라미터 자체가
#    안 나가게 하세요. 안 그러면 400 이 나는데, 클라이언트가 실패를 삼키고 키워드
#    폴백으로 내려가기 때문에 '동작은 하는데 품질이 이상한' 상태가 됩니다.
# =============================================================================
LLM_API_KEY=
# 1·2차 모델이 공유하는 엔드포인트(같은 base_url + api_key).
LLM_BASE_URL=https://api.openai.com/v1
# 1차(primary): 비용 최적화 모델. 공지 요약·선별에는 최상위 모델이 필요 없다.
LLM_MODEL=gpt-5.6-luna
# 2차 폴백: 1차가 rate limit 등으로 막혔을 때 받아준다. 같은 키·URL, 모델 문자열만 다름.
LLM_FALLBACK_MODEL=gpt-5-nano

# 샘플링 온도. 비우면 파라미터를 아예 안 보낸다.
#   • OpenAI gpt-5 / gpt-5.6 / o-시리즈 → 반드시 비워둘 것(거부당함)
#   • Gemini / DeepSeek / GPT-4 계열   → 0 이 결정성에 유리
LLM_TEMPERATURE=
# 추론 강도(gpt-5.6 계열: none/low/medium/high/xhigh/max). 공지 요약·분류는 깊은 추론이
# 필요 없어 낮출수록 추론 토큰(=출력 과금)이 줄어든다. 이 값을 모르는 제공자(GPT-4 계열,
# Gemini 등)에게 보내면 400 이 나므로, 그런 경우엔 비워둔다.
LLM_REASONING_EFFORT=

# 연속 실패가 이 횟수에 도달하면 남은 배치에서 LLM 호출을 건너뛰고 결정론적 폴백만
# 씁니다(회로 차단). rate limit 으로 한도가 소진되면 공지 수백 건마다 1·2차 모델을 계속
# 두드리게 되는데, 요청 간 스로틀까지 붙어 한 번 실행이 몇십 분씩 잠만 잡니다.
# 파이프라인은 매시간 도는 타이머라 그러면 실행이 겹칩니다. 0 이면 차단하지 않습니다.
LLM_CIRCUIT_BREAKER_FAILURES=5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTENT_CHARS=2000
# inbox 편입 및 알림 대상이 되는 최소 관련도(0.0 ~ 1.0)
LLM_RELEVANCE_THRESHOLD=0.5
# 요청 간 최소 간격(초). 프로세스 전역 스로틀.
# 유료 API(OpenAI 등)는 0.3 정도면 충분하다. Gemini 무료 티어처럼 분당 15회 제한이
# 있는 제공자로 바꾼다면 4.5 로 올려 RPM 을 ~15 이하로 눌러야 한다.
LLM_MIN_REQUEST_INTERVAL_SECONDS=0.3

# =============================================================================
# 이메일 알림 (SMTP)
# -----------------------------------------------------------------------------
# 기본값(console)은 실제 메일을 보내지 않고 터미널에 출력만 합니다(데모/테스트용).
# 실제 발송하려면 아래 주석을 해제하고 SMTP 자격 증명을 채우세요.
# Gmail 예시: 2단계 인증 후 "앱 비밀번호"(16자리)를 발급받아 EMAIL_HOST_PASSWORD 에 입력.
#
# ⚠️ 587(STARTTLS) 핸드셰이크가 막혀 "handshake operation timed out" 이 나는 망이 있습니다.
#    그럴 땐 465(SSL) 로 바꾸세요 — 아래 "옵션 B" 주석을 사용하면 됩니다(대개 더 안정적).
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
# 옵션 A — 587 STARTTLS (기본)
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# 옵션 B — 465 SSL (587 이 막힐 때 권장): 위 A 두 줄 대신 아래 세 줄 사용
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
# SMTP 없이 실제 메일 내용(이메일 인증 링크 등)을 눈으로 확인하고 싶을 때:
#   EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
#   EMAIL_FILE_PATH=/home/ubuntu/kkongal-mail   ← 이 디렉터리에 .log 파일로 쌓인다
DEFAULT_FROM_EMAIL=꽁알꽁알 <no-reply@kkongal.cloud>

# =============================================================================
# 슬랙 알림
# -----------------------------------------------------------------------------
# 사용자는 각자 Slack Incoming Webhook URL 을 웹 UI(알림 설정)에서 등록합니다.
# 아래는 등록된 채널이 하나도 없을 때 쓸 선택적 전역 폴백 URL(보통 비워둠).
# =============================================================================
SLACK_DEFAULT_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=10

# ── 프론트엔드 ──────────────────────────────────────────────────────────────
# 알림 메시지의 "대시보드에서 보기" 링크 등에 사용
FRONTEND_URL=http://localhost:3000
