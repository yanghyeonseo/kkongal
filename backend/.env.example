# =============================================================================
# 꽁알꽁알(kkongal) 백엔드 환경 변수 예시
# -----------------------------------------------------------------------------
# 이 파일을 복사해서 backend/.env 로 만들고 값을 채우세요.
#     cp backend/.env.example backend/.env
# .env 는 절대 커밋하지 마세요(.gitignore 에 의해 제외됨).
# =============================================================================

# ── Django 코어 ──────────────────────────────────────────────────────────────
# SECRET_KEY 는 아래 명령으로 새로 생성하는 것을 권장합니다.
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
# 로컬 개발은 True. ⚠️ 프로덕션에서는 반드시 False (스택트레이스·설정 노출 방지).
DEBUG=True

# ── 배포(프로덕션) 설정 — DEBUG=False 일 때 필수 ─────────────────────────────
# 로컬 개발에서는 아래 값들을 비워둬도 됩니다(안전한 기본값으로 동작). AWS 등 배포 시 채우세요.
#
# 서비스 도메인(콤마 구분). DEBUG=False 이면 여기에 없는 Host 요청은 400 으로 막힙니다.
# ALLOWED_HOSTS=kkongal.cloud,www.kkongal.cloud
# HTTPS POST/admin 로그인 신뢰 오리진(스킴 포함, 콤마 구분).
# CSRF_TRUSTED_ORIGINS=https://kkongal.cloud
# SPA 를 API 와 다른 오리진에서 서빙할 때만 필요(동일 오리진 nginx 배포면 불필요).
# CORS_ALLOWED_ORIGINS=https://kkongal.cloud
#
# 데이터베이스. 미설정 시 로컬 SQLite. 프로덕션은 RDS PostgreSQL 을 권장합니다.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
#
# 보안 하드닝(대개 기본값으로 충분, 필요 시만 조정):
#   AUTH_COOKIE_SECURE  : 인증 쿠키 Secure 플래그(기본: DEBUG=False 이면 True)
#   SECURE_SSL_REDIRECT : HTTP→HTTPS 리다이렉트(기본 True). 앞단(nginx)이 리다이렉트하면 False 로.
#   CRAWLER_VERIFY_TLS  : 크롤러 TLS 검증(기본 True, 그대로 두는 것을 권장)
#   LOG_LEVEL           : 로그 레벨(기본 INFO)
#   THROTTLE_AUTH       : 로그인/회원가입 rate limit(기본 10/min)
# AUTH_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# =============================================================================
# AI 공지 선별 (LLM) — OpenAI 호환 Chat Completions API + 3단 캐스케이드
# -----------------------------------------------------------------------------
# 가성비 추천: Google Gemini (무료 티어 존재, 매우 저렴).
#   1) https://aistudio.google.com/apikey 에서 API 키 발급 (무료)
#   2) 아래 LLM_API_KEY 에 붙여넣기
# 키가 비어 있으면 키워드 기반 폴백으로 동작하므로, 키 없이도 데모/테스트가 됩니다.
#
# 3단 캐스케이드로 무료 티어 한도를 방어합니다:
#   1차 = LLM_MODEL  →  2차 = LLM_FALLBACK_MODEL  →  3차 = 결정론적 키워드 폴백
# 1·2차 LLM 은 같은 LLM_BASE_URL·LLM_API_KEY 를 공유하고 '모델 문자열'만 다릅니다.
# 두 LLM 계층이 모두 실패할 때만 대시보드에 "키워드 기반 임시 동작 중" 배너가 뜹니다.
#
# 다른 저렴한 제공자로 교체하려면 BASE_URL / MODEL / API_KEY 세 값만 바꾸면 됩니다:
#   • OpenAI     : LLM_BASE_URL=https://api.openai.com/v1              LLM_MODEL=gpt-4o-mini
#   • DeepSeek   : LLM_BASE_URL=https://api.deepseek.com/v1           LLM_MODEL=deepseek-chat
#   • Groq(무료) : LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
# =============================================================================
LLM_API_KEY=
# 1·2차 모델이 공유하는 엔드포인트(같은 base_url + api_key).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 1차(primary): Gemini 3.1 Flash Lite (무료 티어 ~15 RPM / 500 RPD). 정확한 모델 ID 는 Google AI Studio 확인.
LLM_MODEL=gemini-3.1-flash-lite
# 2차 폴백: Gemma 4 31B (무료 티어 ~15 RPM / 1500 RPD). 같은 키·URL, 모델 문자열만 다름. 정확한 ID 확인.
LLM_FALLBACK_MODEL=gemma-4-31b-it
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTENT_CHARS=2000
# inbox 편입 및 알림 대상이 되는 최소 관련도(0.0 ~ 1.0)
LLM_RELEVANCE_THRESHOLD=0.5
# 요청 간 최소 간격(초). 프로세스 전역 스로틀로 분당 요청수(RPM)를 ~15 이하로 방어.
LLM_MIN_REQUEST_INTERVAL_SECONDS=4.5

# =============================================================================
# 이메일 알림 (SMTP)
# -----------------------------------------------------------------------------
# 기본값(console)은 실제 메일을 보내지 않고 터미널에 출력만 합니다(데모/테스트용).
# 실제 발송하려면 아래 주석을 해제하고 SMTP 자격 증명을 채우세요.
# Gmail 예시: 2단계 인증 후 "앱 비밀번호"(16자리)를 발급받아 EMAIL_HOST_PASSWORD 에 입력.
#
# ⚠️ 587(STARTTLS) 핸드셰이크가 막혀 "handshake operation timed out" 이 나는 망이 있습니다.
#    그럴 땐 465(SSL) 로 바꾸세요 — 아래 "옵션 B" 주석을 사용하면 됩니다(대개 더 안정적).
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
# 옵션 A — 587 STARTTLS (기본)
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# 옵션 B — 465 SSL (587 이 막힐 때 권장): 위 A 두 줄 대신 아래 세 줄 사용
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=꽁알꽁알 <no-reply@kkongal.cloud>

# =============================================================================
# 슬랙 알림
# -----------------------------------------------------------------------------
# 사용자는 각자 Slack Incoming Webhook URL 을 웹 UI(알림 설정)에서 등록합니다.
# 아래는 등록된 채널이 하나도 없을 때 쓸 선택적 전역 폴백 URL(보통 비워둠).
# =============================================================================
SLACK_DEFAULT_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=10

# ── 프론트엔드 ──────────────────────────────────────────────────────────────
# 알림 메시지의 "대시보드에서 보기" 링크 등에 사용
FRONTEND_URL=http://localhost:3000
